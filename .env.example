# Скопируй этот файл в .env и подставь свой ключ.
# .env закрыт в .gitignore и в репозиторий не попадёт.

# Рабочий провайдер: openrouter.ai -> Keys -> Create Key
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Модель OpenRouter. Бесплатные, умеющие вызывать инструменты:
#   nvidia/nemotron-3-super-120b-a12b:free   (по умолчанию)
#   nvidia/nemotron-3-ultra-550b-a55b:free
#   google/gemma-4-31b-it:free
#   liquid/lfm-2.5-2.6b:free                 (крошечная, для сравнения)
MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Предохранитель на число оборотов цикла. Смета по брифу из 6 позиций
# занимает ~11-13 шагов, поэтому меньше 15 ставить не стоит.
# MAX_STEPS=15

# Появится позже, когда решится вопрос с оплатой курса.
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-haiku-4-5
